{
  "ci": {
    "collect": {
      "startServerCommand": "npx --yes serve@14 out -l 4180",
      "startServerReadyPattern": "Accepting connections",
      "url": [
        "http://localhost:4180/",
        "http://localhost:4180/comparateur",
        "http://localhost:4180/performance",
        "http://localhost:4180/rejouer",
        "http://localhost:4180/methodologie"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "onlyCategories": ["accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
